{
  "_comment": "Per-game deterministic state hooks for tools/screenshot.js --state=<id>. Each hook is a JavaScript expression evaluated in the page context that drives the page into a named state and returns true on success. Hooks must be deterministic — no reliance on random timing. Add new games here; screenshot.js needs no change.",
  "hub": {
    "INIT": "true"
  },
  "animals": {
    "INIT": "true",
    "PLAY": "document.querySelector('.animal-card').click(); true"
  },
  "animal_counting": {
    "INIT": "true",
    "PLAY": "document.querySelector('.counting-choice')?.click(); true"
  },
  "animal_memory": {
    "INIT": "true",
    "PLAY": "document.querySelectorAll('.memory-card')[0].click(); true",
    "SUCCESS": "document.querySelectorAll('.memory-card')[0].click(); document.querySelectorAll('.memory-card')[1].click(); true"
  },
